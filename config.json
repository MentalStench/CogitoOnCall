{
  "runHistoryCount": 5,
  "instances": [
    {
      "name": "Epic Caboodle PROD",
      "server": "CDWPRD",
      "dataChecks": [
        {
          "name": "DAG Latency",
          "query": "SELECT drs.last_sent_time [Col1Value], drs.last_redone_time [Col2Value] FROM sys.dm_hadr_database_replica_states drs JOIN sys.availability_replicas ar ON drs.replica_id = ar.replica_id JOIN sys.availability_groups ag ON ar.group_id = ag.group_id WHERE ar.replica_server_name = 'CDW_PRD_AG';",
          "operation": "subtract",
          "threshold": 90,
          "thresholdDirection": "lte",
          "col1Label": "Sent",
          "col2Label": "Redone",
          "resultLabel": "Lag",
          "noDataIsFailure": true
        }
      ]
    },
    
